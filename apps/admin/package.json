{
  "name": "@teralynk/admin",
  "productName": "Teralynk Admin",
  "version": "1.4.0",
  "private": true,
  "description": "Teralynk Admin — panel de publication indépendant : catalogue, annonces, sondages et releases GitHub.",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Teralynk",
    "email": "contact@teralynk.app"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "build:electron": "node ../../scripts/build-electron.mjs admin",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@teralynk/shared": "*",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "zod": "^3.23.8"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
